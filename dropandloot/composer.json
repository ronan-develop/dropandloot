{
  "name": "ronan/symfony-sulu",
  "description": "Symfony 7 + Sulu 3.0 CMS",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Ronan Lenouvel",
      "email": "ronan.develop@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "symfony/console": "^7.0",
    "symfony/dotenv": "^7.0",
    "symfony/flex": "^2.0",
    "symfony/framework-bundle": "^7.0",
    "symfony/runtime": "^7.0",
    "sulu/sulu": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "symfony/maker-bundle": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^1.10"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@symfony-scripts"
    ],
    "post-update-cmd": [
      "@symfony-scripts"
    ],
    "symfony-scripts": [
      "Symfony\\Bundle\\FrameworkBundle\\Composer\\ScriptHandler::clearCache"
    ]
  }
}
